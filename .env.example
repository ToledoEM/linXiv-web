# Copy to .env (gitignored). The port is published on 127.0.0.1 only.
# The container binds 0.0.0.0 inside: with no password below, it starts in
# first-run setup and the first visitor creates the admin password (stored in
# <data dir>/linxiv-web-auth.json). A password set here always wins.

# argon2 hash, generated with:
#   docker compose run --rm --no-deps -e PASSWORD=yourpass linxiv-web python -m app hash-password
# Keep the single quotes: the hash contains '$'.
LINXIV_WEB_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE$ME'

# Or a plain password, hashed in memory at startup (dev only):
# LINXIV_WEB_PASSWORD=change-me

# Session signing key. Unset: generated once and kept in the data dir.
# Changing it logs everyone out.
# LINXIV_WEB_SECRET_KEY=

# Set true when served over HTTPS (reverse proxy).
# LINXIV_WEB_COOKIE_SECURE=false
# Also over HTTPS: tell browsers to never use plain HTTP for this host (1 year).
# LINXIV_WEB_HSTS=false

# Only loopback, private LAN and link-local clients are served by default;
# public IP addresses get 403. Set true to serve the internet.
# LINXIV_WEB_ALLOW_EXTERNAL=false

# Reverse proxies (comma-separated IPs or CIDRs) whose X-Forwarded-For is
# believed. List yours to see real client addresses (login throttle, external
# check); an unlisted proxy is treated as the client itself.
# LINXIV_WEB_TRUSTED_PROXIES=172.16.0.0/12

# Session lifetime in days when "Remember me" is ticked at login (default 90).
# LINXIV_WEB_REMEMBER_DAYS=90

# Host paths for the library DB and PDFs (must exist). Keep the DB on local
# disk; PDFs may live on network/external storage.
# LINXIV_WEB_DATA_HOST=./.dev/data
# LINXIV_WEB_PDF_HOST=./.dev/pdfs

# linXiv tag the CLI is built from.
# LINXIV_REF=v0.6.0

# Hosts the OpenAI-compatible AI base URL may use (comma-separated). Unset: any
# host except cloud metadata addresses, which are always refused.
# LINXIV_WEB_AI_ALLOWED_HOSTS=192.168.1.5,llm.lan

# Upload size cap (MB) and CLI timeouts (seconds).
# LINXIV_WEB_MAX_UPLOAD_MB=200
# LINXIV_WEB_TIMEOUT_LONG=120
# LINXIV_WEB_TIMEOUT_SHORT=30
