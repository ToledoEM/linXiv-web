# Copy to .env (gitignored). The container binds 0.0.0.0 inside, so a password
# is required; the port is published on 127.0.0.1 only.

# argon2 hash, generated with:
#   docker compose run --rm --no-deps -e PASSWORD=yourpass linxiv-web python -m app hash-password
# Keep the single quotes: the hash contains '$'.
LINXIV_WEB_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE$ME'

# Or a plain password, hashed in memory at startup (dev only):
# LINXIV_WEB_PASSWORD=change-me

# Session signing key. Unset: random per start (restart logs you out).
# LINXIV_WEB_SECRET_KEY=

# Set true when served over HTTPS (reverse proxy).
# LINXIV_WEB_COOKIE_SECURE=false

# Host paths for the library DB and PDFs (must exist). Keep the DB on local
# disk; PDFs may live on network/external storage.
# LINXIV_WEB_DATA_HOST=./.dev/data
# LINXIV_WEB_PDF_HOST=./.dev/pdfs

# linXiv tag the CLI is built from.
# LINXIV_REF=v0.6.0

# Upload size cap (MB) and CLI timeouts (seconds).
# LINXIV_WEB_MAX_UPLOAD_MB=200
# LINXIV_WEB_TIMEOUT_LONG=120
# LINXIV_WEB_TIMEOUT_SHORT=30
